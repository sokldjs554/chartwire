# 스톡 PostgreSQL 16 설치의 기본 슈퍼유저 (CI 가 쓰는 값과 동일). `db bootstrap-roles`,
# perf study, superuser 누출 테스트에서만 쓴다. 빌드 박스처럼 다른 슈퍼유저 역할을 쓰는
# 환경은 이 파일을 고치지 말고 추적되지 않는 `.env` 에 적는다 (scripts/dev_up.sh 가 먼저 읽는다).
CHARTWIRE_SUPERUSER_URL=postgresql://postgres@localhost:5432/postgres
CHARTWIRE_DATABASE_URL=postgresql+asyncpg://chartwire_app:chartwire_app@localhost:5432/chartwire
CHARTWIRE_DATABASE_OWNER_URL=postgresql+psycopg://chartwire_owner:chartwire_owner@localhost:5432/chartwire
CHARTWIRE_REDIS_URL=redis://localhost:6379/0
CHARTWIRE_KEK_MASTER=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CHARTWIRE_JWT_SECRET=dev-secret-change-me
CHARTWIRE_OBJECTSTORE=localfs:./var/objects
CHARTWIRE_NOTE_PROVIDER=extractive
CHARTWIRE_NODE_ID=dev-1
